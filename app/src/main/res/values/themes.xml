<resources>
    <style name="Theme.LazyBuzz.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ink</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.LazyBuzz</item>
    </style>

    <style name="Theme.LazyBuzz" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ink</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
